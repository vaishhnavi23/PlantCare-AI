# Copy to backend/.env and edit. Never commit the real .env.
# Session signing key. If empty, a random key is generated once and stored in backend/data/.secret_key.
SECRET_KEY=
MODEL_ID=mesabo/agri-plant-disease-resnet50
# Weather: leave empty to use the keyless Open-Meteo API, or paste an OpenWeatherMap key (https://openweathermap.org/api).
OPENWEATHER_API_KEY=
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
MAX_UPLOAD_MB=5
# Below this model probability a result is flagged as uncertain.
LOW_CONFIDENCE=0.60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
